---
import { situations } from '../data/content';
import { wa } from '../lib/whatsapp';
---

<section id="situasi" class="section">
	<header class="section-head">
		<p class="eyebrow">Apa yang sedang Anda alami?</p>
		<h2>Pilih situasi Anda</h2>
	</header>
	<div class="cards">
		{situations.map((s) => (
			<article class="card">
				<div class="card-img-wrap">
					<img class="card-img" src={s.img} alt={s.title} loading="lazy" />
					{s.badge && <span class="card-badge">{s.badge}</span>}
				</div>
				<div class="card-body">
					<h3>{s.title}</h3>
					<p>{s.body}</p>
					{s.slug ? (
						<a class="card-link" href={`/layanan/${s.slug}/`}>Pelajari layanan →</a>
					) : (
						<a class="card-link" href={wa(s.msg)} target="_blank" rel="noopener">{s.cta} →</a>
					)}
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.cards {
		display: grid;
		gap: 14px;
		grid-template-columns: 1fr;
	}
	.card {
		overflow: hidden;
		border-radius: 14px;
		background: var(--surface);
		border: 1px solid var(--line);
		transition: border-color 0.18s ease, transform 0.18s ease;
	}
	.card:hover {
		border-color: var(--green);
		transform: translateY(-2px);
	}
	.card-img-wrap {
		position: relative;
	}
	.card-img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		object-position: top;
	}
	.card-badge {
		position: absolute;
		top: 10px;
		left: 10px;
		background: var(--green);
		color: #fff;
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.02em;
		padding: 4px 10px;
		border-radius: 999px;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
	}
	.card-body {
		padding: 16px;
	}
	.card h3 {
		margin: 0 0 6px;
		font-size: 17px;
	}
	.card p {
		margin: 0 0 12px;
		color: var(--muted);
		line-height: 1.45;
		font-size: 13.5px;
	}
	.card-link {
		color: var(--green);
		font-weight: 600;
		font-size: 14.5px;
	}
	@media (min-width: 640px) {
		.cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 900px) {
		.cards {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>