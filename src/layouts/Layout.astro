---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	canonical?: string;
	noindex?: boolean;
}

const {
	title = 'Tentram — Rumah Bersih Tanpa Ribet',
	description = 'Tentram — cleaning profesional untuk rumah, apartemen, dan kantor. Post renovation, move in, home cleaning, deep cleaning, & office cleaning. Dapatkan penawaran gratis via WhatsApp.',
	ogImage = '/aman-dengan-dokumentasi.png',
	canonical,
	noindex = false,
} = Astro.props;

const canonicalUrl = canonical ? new URL(canonical, Astro.site ?? 'https://tentram.id/') : new URL(Astro.url.pathname, Astro.site ?? 'https://tentram.id/');
---

<!doctype html>
<html lang="id">
	<head>
		<!-- Google Tag Manager -->
		<script is:inline>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', 'GTM-PXRLQC8G');
		</script>
		<!-- End Google Tag Manager -->

		<!-- Google Ads: conversion tracking -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=AW-18308049507"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'AW-18308049507');

			function gtag_report_conversion(url) {
				var callback = function () {
					if (typeof url != 'undefined') {
						window.location = url;
					}
				};
				gtag('event', 'conversion', {
					send_to: 'AW-18308049507/MDFHCPjhtc0cEOPU-plE',
					event_callback: callback,
				});
				return false;
			}
		</script>
		<!-- End Google Ads conversion tracking -->
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.url)} />
		<!-- Schema.org LocalBusiness + Service -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'LocalBusiness',
					'@id': 'https://tentram.id/#business',
					name: 'Tentram Cleaning Service',
					url: 'https://tentram.id/',
					telephone: '+62-877-9050-7560',
					email: 'tentramcleaning@gmail.com',
					image: 'https://tentram.id/aman-dengan-dokumentasi.png',
					description,
					address: {
						'@type': 'PostalAddress',
						addressLocality: 'Jakarta',
						addressRegion: 'DKI Jakarta',
						addressCountry: 'ID',
					},
					areaServed: [
						{ '@type': 'City', name: 'Jakarta' },
						{ '@type': 'City', name: 'BSD' },
						{ '@type': 'City', name: 'Alam Sutera' },
						{ '@type': 'City', name: 'Gading Serpong' },
						{ '@type': 'City', name: 'Bekasi' },
						{ '@type': 'City', name: 'Depok' },
						{ '@type': 'City', name: 'Tangerang' },
					],
					sameAs: [
						'https://www.instagram.com/tentramcleaning/',
					],
					priceRange: '$$',
				},
				{
					'@type': 'WebSite',
					'@id': 'https://tentram.id/#website',
					url: 'https://tentram.id/',
					name: 'Tentram Cleaning Service',
					publisher: { '@id': 'https://tentram.id/#business' },
					potentialAction: {
						'@type': 'SearchAction',
						target: 'https://tentram.id/blog/?search={search_term_string}',
						'query-input': 'required name=search_term_string',
					},
				},
			],
		})} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, Astro.url)} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-PXRLQC8G"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- End Google Tag Manager (noscript) -->
		<slot />

		<script is:inline>
			document.addEventListener('click', function (e) {
				var link = e.target.closest('a[href*="wa.me"]');
				if (link) gtag_report_conversion();
			});
		</script>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	body {
		background: #ffffff;
		color: #16201a;
		font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
			'Helvetica Neue', Arial, sans-serif;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}
</style>