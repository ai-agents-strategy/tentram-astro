---
import { reasons, steps, areas } from '../../data/content';
import { wa } from '../../lib/whatsapp';
import WhatsAppIcon from '../../components/icons/WhatsAppIcon.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import StickyWhatsApp from '../../components/StickyWhatsApp.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const { services } = await import('../../data/content');
	return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: service.title,
	description: service.description,
	url: new URL(`/layanan/${service.slug}/`, Astro.site).toString(),
	provider: {
		'@type': 'LocalBusiness',
		'@id': 'https://tentram.id/#business',
		name: 'Tentram Cleaning Service',
	},
	areaServed: areas.map((a) => ({ '@type': 'City', name: a })),
};
---

<Layout
	title={`${service.title} — Tentram Cleaning Service`}
	description={service.description}
	ogImage={service.image}
	canonical={`/layanan/${service.slug}/`}
>
	<main>
		<SiteHeader />

		<section class="service-hero">
			<div class="service-hero-copy">
				<p class="eyebrow">Layanan Tentram</p>
				<h1>{service.headline}</h1>
				<p class="service-hero-desc">{service.description}</p>
				<a class="btn btn-wa btn-lg" href={wa(service.ctaMsg)} target="_blank" rel="noopener">
					<WhatsAppIcon />
					WhatsApp untuk Penawaran
				</a>
			</div>
			<div class="service-hero-media">
				<img src={service.image} alt={service.title} loading="eager" />
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">Apa yang kami kerjakan</h2>
			<p class="service-body">{service.body}</p>
		</section>

		<section class="section">
			<h2 class="section-title">Termasuk dalam layanan</h2>
			<ul class="checklist">
				{service.includes.map((item) => <li>{item}</li>)}
			</ul>
			{service.addOns && (
				<>
					<h3 class="subsection-title">Add-on yang tersedia</h3>
					<ul class="checklist add-on">
						{service.addOns.map((item) => <li>{item}</li>)}
					</ul>
				</>
			)}
			{service.notIncludes && (
				<>
					<h3 class="subsection-title">Tidak termasuk</h3>
					<ul class="crosslist">
						{service.notIncludes.map((item) => <li>{item}</li>)}
					</ul>
				</>
			)}
		</section>

		<section class="section">
			<h2 class="section-title">Area layanan</h2>
			<ul class="areas">
				{areas.map((a) => <li>{a}</li>)}
			</ul>
		</section>

		<section class="section">
			<h2 class="section-title">Kenapa pilih Tentram?</h2>
			<div class="grid-why">
				{reasons.map((r) => (
					<article class="why">
						<span class="why-emoji" aria-hidden="true">{r.emoji}</span>
						<h3>{r.title}</h3>
						<p>{r.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">Cara booking</h2>
			<ol class="steps">
				{steps.map((s) => (
					<li class="step">
						<span class="step-n">{s.n}</span>
						<div>
							<h3>{s.title}</h3>
							<p>{s.body}</p>
						</div>
					</li>
				))}
			</ol>
		</section>

		<section class="section">
			<h2 class="section-title">Pertanyaan umum</h2>
			<div class="faq">
				{service.faq.map((f) => (
					<details class="faq-item">
						<summary>{f.q}<span class="faq-icon" aria-hidden="true">+</span></summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</section>

		<section class="section tnc">
			<h2 class="section-title">Syarat dan ketentuan</h2>
			<ul class="tnc-list">
				<li>Harga final ditentukan setelah survey atau informasi detail area, kondisi, dan kebutuhan diterima.</li>
				<li>Booking dikonfirmasi setelah jadwal dan estimasi disetujui kedua belah pihak.</li>
				<li>Reschedule dapat dilakukan minimal H-1 sebelum jadwal yang disepakati.</li>
				<li>Pembatalan di hari H dikenakan biaya sesuai kebijakan operasional kami.</li>
				<li>Area yang belum dijelaskan saat booking dapat menambah waktu dan biaya.</li>
				<li>Kerusakan yang sudah ada sebelum cleaning bukan tanggung jawab Tentram.</li>
				<li>Setiap layanan mengikuti quality checklist. Keluhan setelah serah terima harap disampaikan dalam 24 jam.</li>
			</ul>
		</section>

		<section class="final-cta">
			<h2>Tertarik dengan layanan {service.title}?</h2>
			<p>Chat tim Tentram via WhatsApp untuk estimasi gratis dan penjadwalan.</p>
			<a class="btn btn-wa btn-lg" href={wa(service.ctaMsg)} target="_blank" rel="noopener">
				<WhatsAppIcon />
				Chat WhatsApp Sekarang
			</a>
		</section>

		<SiteFooter />
	</main>
	<StickyWhatsApp />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
	main {
		width: 100%;
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 22px 90px;
	}

	.service-hero {
		padding: 36px 0 28px;
		display: grid;
		gap: 28px;
		align-items: center;
	}
	.service-hero-copy {
		text-align: center;
	}
	.service-hero-copy h1 {
		margin: 12px 0 0;
		font-size: 32px;
		line-height: 1.12;
		letter-spacing: -0.02em;
	}
	.service-hero-desc {
		margin: 16px auto 0;
		max-width: 44ch;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.55;
	}
	.service-hero-media {
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--surface);
	}
	.service-hero-media img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.section {
		padding: 42px 0 0;
	}
	.section-title {
		font-size: 22px;
		margin: 0 0 18px;
		letter-spacing: -0.01em;
	}
	.subsection-title {
		font-size: 16px;
		margin: 24px 0 12px;
		color: var(--muted);
	}

	.service-body {
		color: var(--text);
		font-size: 16px;
		line-height: 1.65;
		margin: 0;
	}

	.checklist {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 10px;
	}
	.checklist li {
		position: relative;
		padding-left: 28px;
		font-size: 15px;
		line-height: 1.5;
	}
	.checklist li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--green);
		font-weight: 700;
	}
	.crosslist {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 10px;
	}
	.crosslist li {
		position: relative;
		padding-left: 28px;
		font-size: 15px;
		line-height: 1.5;
		color: var(--muted);
	}
	.crosslist li::before {
		content: '✕';
		position: absolute;
		left: 0;
		color: #b0b0b0;
	}

	.areas {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.areas li {
		padding: 8px 14px;
		border-radius: 999px;
		background: var(--surface);
		border: 1px solid var(--line);
		font-size: 14px;
		font-weight: 500;
		color: var(--muted);
	}

	.grid-why {
		display: grid;
		gap: 12px;
		grid-template-columns: 1fr;
	}
	.why {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 10px;
		padding: 28px 20px;
		border-radius: 16px;
		background: var(--surface);
		border: 1.5px solid var(--green);
	}
	.why-emoji {
		flex-shrink: 0;
		display: inline-grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--green);
		font-size: 28px;
		line-height: 1.2;
	}
	.why h3 {
		margin: 0;
		font-size: 17px;
		font-weight: 800;
		color: var(--green);
	}
	.why p {
		margin: 0;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.45;
	}

	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 10px;
	}
	.step {
		display: flex;
		gap: 16px;
		align-items: center;
		padding: 14px 18px;
		border-radius: 12px;
		background: var(--surface);
		border: 1px solid var(--line);
	}
	.step-n {
		flex-shrink: 0;
		display: inline-grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--green);
		color: #fff;
		font-weight: 700;
		font-size: 14px;
	}
	.step h3 {
		margin: 0 0 1px;
		font-size: 15px;
	}
	.step p {
		margin: 0;
		color: var(--muted);
		font-size: 13.5px;
	}

	.faq {
		display: grid;
		gap: 8px;
	}
	.faq-item {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 12px;
	}
	.faq-item summary {
		list-style: none;
		cursor: pointer;
		padding: 18px 20px;
		font-weight: 600;
		font-size: 15px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
	}
	.faq-item summary::-webkit-details-marker {
		display: none;
	}
	.faq-item[open] summary {
		color: var(--green);
	}
	.faq-icon {
		flex-shrink: 0;
		font-size: 20px;
		line-height: 1;
		color: var(--green);
		transition: transform 0.2s ease;
	}
	.faq-item[open] .faq-icon {
		transform: rotate(45deg);
	}
	.faq-item p {
		margin: 0;
		padding: 0 20px 18px;
		color: var(--muted);
		font-size: 14.5px;
		line-height: 1.55;
	}

	.tnc {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 16px;
		padding: 24px;
		margin-top: 42px;
	}
	.tnc-list {
		margin: 0;
		padding-left: 18px;
		display: grid;
		gap: 10px;
	}
	.tnc-list li {
		font-size: 14px;
		line-height: 1.55;
		color: var(--muted);
	}

	.final-cta {
		padding: 48px 0 8px;
		text-align: center;
	}
	.final-cta h2 {
		font-size: 26px;
		letter-spacing: -0.02em;
		margin: 0;
	}
	.final-cta p {
		margin: 14px auto 22px;
		max-width: 44ch;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.6;
	}

	@media (min-width: 640px) {
		.service-hero-copy h1 {
			font-size: 40px;
		}
		.service-hero {
			grid-template-columns: 1fr 1fr;
			gap: 40px;
		}
		.service-hero-copy {
			text-align: left;
		}
		.grid-why {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 900px) {
		.service-hero-copy h1 {
			font-size: 48px;
		}
		.grid-why {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
