---
import { solutions } from '../data/content';
---

<section id="solusi" class="section">
	<header class="section-head">
		<p class="eyebrow">Solusi kami</p>
		<h2>Layanan Tentram</h2>
	</header>
	<div class="chips">
		{solutions.map((s) => (
			<div class="chip">
				<h3>{s.title}</h3>
				<p>{s.body}</p>
			</div>
		))}
	</div>
</section>

<style>
	.chips {
		display: grid;
		gap: 12px;
		grid-template-columns: 1fr;
	}
	.chip {
		padding: 18px;
		border-radius: 12px;
		background: var(--surface);
		border: 1px solid var(--line);
	}
	.chip h3 {
		margin: 0 0 4px;
		font-size: 16px;
		color: var(--text);
	}
	.chip p {
		margin: 0;
		color: var(--muted);
		font-size: 14.5px;
	}
	@media (min-width: 640px) {
		.chips {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 900px) {
		.chips {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>