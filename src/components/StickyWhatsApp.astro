---
import { wa } from '../lib/whatsapp';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
---

<a class="wa-sticky" href={wa('Halo Tentram, saya ingin bertanya tentang layanan cleaning.')} target="_blank" rel="noopener" aria-label="WhatsApp Us">
	<WhatsAppIcon size={26} />
	<span>WhatsApp Us</span>
</a>

<style>
	.wa-sticky {
		position: fixed;
		right: 16px;
		bottom: 16px;
		z-index: 40;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 12px 16px 12px 13px;
		border-radius: 999px;
		background: var(--wa);
		color: #fff;
		font-weight: 600;
		font-size: 14px;
		box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
		transition: background 0.18s ease, transform 0.18s ease;
	}
	.wa-sticky:hover {
		background: var(--wa-hover);
		transform: translateY(-2px);
	}
</style>