---
import { reasons } from '../data/content';
---

<section id="alasan" class="section">
	<header class="section-head">
		<p class="eyebrow">Kenapa Tentram?</p>
		<h2>Kami jawab kekhawatiran Anda</h2>
	</header>
	<div class="grid-why">
		{reasons.map((r) => (
			<article class="why">
				<span class="why-emoji" aria-hidden="true">{r.emoji}</span>
				<h3>{r.title}</h3>
				<p>{r.body}</p>
			</article>
		))}
	</div>
</section>

<style>
	.grid-why {
		display: grid;
		gap: 12px;
		grid-template-columns: 1fr;
	}
	.why {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 10px;
		padding: 28px 20px;
		border-radius: 16px;
		background: var(--surface);
		border: 1.5px solid var(--green);
	}
	.why-emoji {
		flex-shrink: 0;
		display: inline-grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--green);
		font-size: 28px;
		line-height: 1.2;
	}
	.why h3 {
		margin: 0;
		font-size: 18px;
		font-weight: 800;
		color: var(--green);
	}
	.why p {
		margin: 0;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.45;
	}
	@media (min-width: 640px) {
		.grid-why {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 900px) {
		.grid-why {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>