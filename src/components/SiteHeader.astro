---
import { wa } from '../lib/whatsapp';
---

<header class="site-header">
	<a class="brand" href="#top">
		<span class="brand-mark" aria-hidden="true">✦</span>
		<span>Tentram</span>
	</a>
	<nav class="nav-links" aria-label="Primary">
		<a href="#situasi">Situasi</a>
		<a href="#solusi">Layanan</a>
		<a href="#alasan">Kenapa Kami</a>
		<a href="#faq">FAQ</a>
	</nav>
	<a class="btn btn-wa nav-cta" href={wa('Halo Tentram, saya tertarik dengan layanan cleaning. Boleh minta penawaran gratis?')} target="_blank" rel="noopener">
		WhatsApp
	</a>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 30;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 18px 0;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(10px);
	}
	.nav-links {
		display: none;
		gap: 26px;
		font-size: 15px;
		color: var(--muted);
	}
	.nav-links a:hover {
		color: var(--text);
	}
	.nav-cta {
		padding: 10px 16px;
		font-size: 14px;
	}
	@media (min-width: 900px) {
		.nav-links {
			display: flex;
		}
	}
</style>